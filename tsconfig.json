{
	"compilerOptions": {
		"strict": true,
		"module": "commonjs",
		"moduleResolution": "node",
		"target": "es2022",
		"lib": ["es2022"],
		"declaration": true,
		"sourceMap": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,
		"outDir": "./dist/",
		"rootDir": "."
	},
	"include": ["credentials/**/*.ts", "nodes/**/*.ts"],
	"exclude": ["node_modules", "dist"]
}
